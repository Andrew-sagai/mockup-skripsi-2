# =============================================================================
# Konfigurasi Supabase — salin ke `.env.local` lalu isi nilainya.
# `.env.local` TIDAK boleh di-commit (sudah ada di .gitignore).
#
# Biarkan NEXT_PUBLIC_SUPABASE_URL kosong → aplikasi berjalan dalam MODE DEMO
# (state lokal seperti sebelumnya, tidak error sama sekali).
# =============================================================================

# URL project Supabase (Dashboard → Project Settings → API)
# contoh: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — HANYA untuk script seed/reset di server.
# JANGAN pernah memakai key ini di kode yang dijalankan di browser.
SUPABASE_SERVICE_ROLE_KEY=

# Rahasia penjadwal (server only). Dipakai route GET /api/cron/reminder
# untuk menjalankan pengingat batas waktu disposisi.
# Isi dengan string acak panjang, misal: openssl rand -hex 24
CRON_SECRET=

# Connection string Postgres — HANYA untuk `npm run supabase:migrate`
# (menjalankan berkas di supabase/migrations ke database proyek).
# Dashboard → Project Settings → Database → Connection string → URI.
# Ganti <PASSWORD> dengan password database proyek Anda.
# Mode "Session pooler" (port 5432) paling aman untuk migrasi.
# Password yang mengandung karakter khusus (@ : / ? #) harus URL-encoded.
DATABASE_URL=

